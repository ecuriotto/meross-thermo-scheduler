#!/bin/sh /etc/rc.common
# /etc/init.d/meross-scheduler
# OpenWrt procd service for Meross Thermostat Scheduler

START=95
STOP=10
USE_PROCD=1

APP_DIR="/root/meross-thermo-scheduler"
PYTHON_BIN="/usr/bin/python3"

start_service() {
    procd_open_instance
    procd_set_param command "$PYTHON_BIN" -m uvicorn app.main:app --host 0.0.0.0 --port 8000
    procd_set_param working_dir "$APP_DIR"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
